{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["_site/**"]
    },
    "css": {
      "outputs": ["_site/static/css/**"],
      "cache": false,
      "persistent": true
    },
    "eleventy": {
      "cache": false,
      "persistent": true
    },
    "browsersync": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "debug": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "sort-package-json": {
      "cache": false
    }
  }
}
