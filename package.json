{
  "name": "tierundarzt",
  "version": "1.0.0",
  "main": ".eleventy.js",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "cross-env NODE_ENV=production eleventy && cross-env NODE_ENV=production postcss src/static/css/tailwind.css --o _site/static/css/style.css",
    "browsersync": "browser-sync start --server '_site' --files '_site' --port 8080 --no-notify --no-open",
    "css": "postcss src/static/css/tailwind.css --o _site/static/css/style.css --watch",
    "debug": "set DEBUG=* & eleventy",
    "deploy": "node scripts/deploy.js",
    "dev": "npm-run-all --parallel css eleventy browsersync",
    "dev:live": "npm-run-all --parallel css eleventy browsersync watch",
    "eleventy": "eleventy --watch --serve",
    "format": "prettier --write .",
    "sort-package-json": "sort-package-json \"./package.json\"",
    "watch": "node watch.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "tabWidth": 2,
    "useTabs": false
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@tailwindcss/typography": "^0.5.2",
    "autoprefixer": "^10.4.7",
    "basic-ftp": "^5.0.2",
    "browser-sync": "^3.0.4",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "dotenv": "^16.4.7",
    "ftps": "^1.2.0",
    "html-minifier": "^4.0.0",
    "js-yaml": "^4.1.0",
    "json-keys-sort": "^2.1.0",
    "luxon": "^3.6.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.18",
    "postcss-cli": "^10.0.0",
    "prettier": "^3.5.3",
    "prismjs": "^1.30.0",
    "sftp-sync-deploy": "^0.7.1",
    "sort-package-json": "^2.4.1",
    "ssh2-sftp-client": "^12.1.1",
    "tailwindcss": "^3.2.2",
    "yml": "^1.0.0"
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "uploadConfig": {
    "user": "tierundarztat",
    "host": "tieruo.ssh.transip.me",
    "localDir": "_site"
  }
}
