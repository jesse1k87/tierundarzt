{
  "name": "tierundarzt",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": ".eleventy.js",
  "scripts": {
    "browsersync": "browser-sync start --server 'docs' --files 'docs' --port 8080 --no-notify --no-open",
    "build": "cross-env NODE_ENV=production eleventy && cross-env NODE_ENV=production postcss src/static/css/tailwind.css --o docs/static/css/style.css",
    "css": "postcss src/static/css/tailwind.css --o docs/static/css/style.css --watch",
    "debug": "set DEBUG=* & eleventy",
    "dev": "npm-run-all --parallel css eleventy browsersync",
    "eleventy": "eleventy --watch --serve",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "tabWidth": 2,
    "useTabs": false
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@tailwindcss/typography": "^0.5.2",
    "autoprefixer": "^10.4.7",
    "browser-sync": "^3.0.4",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "html-minifier": "^4.0.0",
    "js-yaml": "^4.1.0",
    "json-keys-sort": "^2.1.0",
    "luxon": "^3.6.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.18",
    "postcss-cli": "^10.0.0",
    "postcss-import": "17.0.0",
    "prettier": "^3.5.3",
    "prismjs": "^1.30.0",
    "tailwindcss": "^3.2.2",
    "yml": "^1.0.0"
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=16.14.0"
  }
}
